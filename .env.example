POSTGRES_USER=sonora
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=sonoraplay
PG_PORT=5432
DATABASE_URL=postgresql+psycopg://sonora:cambia_esto@localhost:5432/sonoraplay
TEST_DATABASE_URL=postgresql+psycopg://sonora:cambia_esto@localhost:5432/sonoraplay_test
SEED=42
TASA_DEFECTOS=0.02
API_CONTRATOS_PORT=8000
API_TITULARES_PORT=8001
# Clave de firma de los tokens de sellos (ADR-0006). Este valor es FALSO y la app lo rechaza.
# Genera la tuya: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TITULARES_JWT_SECRET=cambia_esto
# Seed en Docker Compose (EG-25). Por defecto, la muestra versionada con 50 titulares.
# Para el CSV completo de Kaggle en data/raw/dataset.csv (ver README):
# F1_ENTRADA=/datos/entrada/raw/dataset.csv
# F1_TITULARES=1500
# F3_MODO=dev
# Esqueleto (EG-24): ingresos publicitarios del país en USD. PROVISIONAL hasta F5 (EG-30).
# ESQUELETO_PUBLICIDAD_USD=20000
# Mensajería F2 (EG-29). Valores FALSOS: cámbialos. La URL usa el mismo usuario y contraseña.
RABBITMQ_USER=sonora
RABBITMQ_PASSWORD=cambia_esto
RABBITMQ_PORT=5672
RABBITMQ_CONSOLA_PORT=15672
RABBITMQ_URL=amqp://sonora:cambia_esto@localhost:5672/%2F

# Airflow (EG-34). Valores FALSOS: genera los tuyos.
#   Fernet:  uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Otros:   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=cambia_esto
AIRFLOW_JWT_SECRET=cambia_esto
AIRFLOW_DB_PASSWORD=cambia_esto
AIRFLOW_PORT=8080
# Comando del job Bronze -> Silver de Spark (EG-35). {fecha} = AAAA-MM-DD UTC. Vacío = tarea omitida.
# SILVER_JOB_COMMAND=python -m sonoraplay.silver --fecha {fecha}
# Job de liquidación mensual (EG-37). {periodo} = AAAA-MM. Vacío = tarea omitida.
# LIQUIDACION_JOB_COMMAND=python -m sonoraplay.liquidacion --periodo {periodo}
# Tema SNS al que avisa el DAG mensual cuando una tarea agota sus reintentos (EG-32).
# ALERTA_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:sonoraplay-alertas
